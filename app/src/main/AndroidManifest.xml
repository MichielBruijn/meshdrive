<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- The ESP32 only ever speaks plain http/ws (no TLS capability), both as its own
         AP and on a home network - cleartext must stay allowed for this app.
         allowBackup deliberately false: the only real data this app stores is the
         recent-vehicles list (ModePrefs' DataStore) - Yggdrasil addresses and their
         assigned names, a form of network identity - which has no business ending
         up in Android's default cloud auto-backup without an explicit decision to
         allow that. -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:theme="@style/Theme.RcVehicle"
        android:usesCleartextTraffic="true">

        <!-- Mode picker: two buttons, no reason to ever be sideways. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Auto-launches this app when the ESP32 is plugged in via USB-OTG,
                 matching one of the chips in device_filter.xml. Still opens the
                 mode picker (not straight into VehicleActivity) - picking "Voertuig"
                 is a one-tap follow-up. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Pairing/setup screen: address field, QR scan, connect. Plain portrait. -->
        <activity
            android:name=".controller.ControllerActivity"
            android:exported="false" />

        <!-- The actual driving screen: video + joysticks + STOP. Always landscape -
             two-hand steer/throttle needs the width, and the setup screen's
             portrait keyboard use has no place here. configChanges: this owns live
             state (UDP control link, video receiver) that must survive a rotation -
             without it, Android's default destroy-and-recreate-the-Activity
             behavior on orientation change tore all of that down (confirmed on
             real hardware as "turning the vehicle phone stops the video on the
             controller", back when this UI lived in one un-orientation-locked
             activity). -->
        <activity
            android:name=".controller.ControllerDriveActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- configChanges: owns live state (USB/UDP sockets, camera capture, video
             encoding) that must survive a rotation - see ControllerDriveActivity's
             comment above for why. -->
        <activity
            android:name=".vehicle.VehicleActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <service
            android:name=".vehicle.VehicleForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera|microphone|location" />

        <!-- Embedded Yggdrasil mesh node - see YggdrasilVpnService's doc for why this
             replaces relying on the separate eu.neilalexander.yggdrasil app. -->
        <service
            android:name=".yggdrasil.YggdrasilVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
