<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/textAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_picker_title"
        android:textSize="16sp"
        android:alpha="0.7"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonController"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mode_controller" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <Button
        android:id="@+id/buttonVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mode_vehicle" />

    <!-- Hidden until textAppVersion below is tapped 7 times - see MainActivity, same
         convention as Android's own "tap build number to enable developer options". -->
    <CheckBox
        android:id="@+id/checkDebugMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/main_debug_mode"
        android:visibility="gone" />

    <!-- Same debug-mode gating as checkDebugMode above (MainActivity toggles both
         together) - comma-separated Yggdrasil peer URIs (tls://host:port), applied
         the next time a mode is picked (YggdrasilController.start() reads it fresh
         each time, not live while a mesh session is already running). -->
    <EditText
        android:id="@+id/editYggdrasilPeers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/main_yggdrasil_peers_hint"
        android:inputType="textUri"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonSaveYggdrasilPeers"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_yggdrasil_peers_save"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:alpha="0.6" />

    <!-- Hidden unless a startup check (MainActivity/AppUpdater) actually finds a
         newer GitHub release than this build - not a permanent fixture, so it
         doesn't compete with the two big mode buttons above on every launch. -->
    <Button
        android:id="@+id/buttonUpdateApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textUpdateStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:alpha="0.6"
        android:visibility="gone" />

</LinearLayout>
