<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/controller_setup_title"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Populated in code (ControllerActivity) from ModePrefs.recentVehicleAddresses -
         tapping a row connects straight to it, no re-scanning needed. Hidden (both the
         title and the list itself) when there's nothing to show yet. -->
    <TextView
        android:id="@+id/textRecentVehiclesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/controller_recent_vehicles"
        android:textSize="14sp"
        android:alpha="0.7"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/recentVehiclesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <!-- Scanning connects immediately (ControllerActivity) - the only action needed
         for a vehicle not already in the list above. -->
    <Button
        android:id="@+id/buttonScanQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controller_scan_qr" />

    <!-- Manual address entry - debug-only, hidden unless "Debug mode" is on
         (MainActivity): scanning the QR is the normal way to pair. -->
    <LinearLayout
        android:id="@+id/debugSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editVehicleAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/controller_vehicle_address_hint"
            android:inputType="text" />

        <Button
            android:id="@+id/buttonConnectRtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/controller_connect" />

    </LinearLayout>

</LinearLayout>
</ScrollView>
