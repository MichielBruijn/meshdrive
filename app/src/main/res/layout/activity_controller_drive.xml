<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- TextureView (not SurfaceView) because correct display needs a rotation
         transform (Matrix) - SurfaceView doesn't support that, TextureView does.
         Sized/rotated in code once the vehicle's orientation is known, kept at its
         native aspect ratio (no stretching) - see ControllerDriveActivity. -->
    <TextureView
        android:id="@+id/textureVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Steering, left side, vertically centered: horizontal slider, left/right only.
         Nudged in further than a plain edge margin - on some phones (front-camera
         cutout in landscape) the very left edge sits under/behind the controller's
         own camera, per direct feedback. -->
    <nu.bruijn.rcvehicle.controller.SliderView
        android:id="@+id/sliderSteer"
        android:layout_width="240dp"
        android:layout_height="100dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="70dp" />

    <!-- Throttle, vertically centered, nudged in from the right edge for easier
         thumb reach: vertical slider, forward/backward only. -->
    <nu.bruijn.rcvehicle.controller.SliderView
        android:id="@+id/sliderThrottle"
        android:layout_width="100dp"
        android:layout_height="240dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="50dp" />

    <!-- Always visible (not debug) - a real driving-safety signal, not a diagnostic
         detail. Hidden (empty text) while the link looks healthy. -->
    <TextView
        android:id="@+id/textConnectionWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:textColor="#FFEB3B"
        android:textStyle="bold"
        android:background="#AA000000"
        android:padding="8dp" />

    <!-- Switches which of the vehicle phone's two cameras streams - see
         VideoSender.switchCamera(). Not a picture-in-picture mirror: that needs
         concurrent dual-camera capture, confirmed on real hardware (2026-09-13) as
         unsupported here - CameraManager.concurrentCameraIds came back empty on the
         Fairphone 5. This swaps the single stream instead, so the main view itself
         becomes the rear view while active - label/tint (ControllerDriveActivity)
         show which one is currently live. -->
    <Button
        android:id="@+id/buttonRearView"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:text="@string/controller_rear_view" />

    <!-- Mutes both directions of the mic link - see the Mute button's doc
         (ControllerDriveActivity) for why one icon covers both. Always visible,
         not debug-only: same category as rear view, a normal driving control.
         Icon-only (speaker / speaker-with-slash, ic_lock_silent_mode{,_off} -
         standard AOSP icons, no new asset needed) on a dark scrim so it stays
         visible over bright video. -->
    <ImageButton
        android:id="@+id/buttonMute"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/icon_button_bg"
        android:src="@android:drawable/ic_lock_silent_mode_off"
        android:contentDescription="@string/controller_mute"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <!-- Debug-only per direct request (moved back after briefly being always-
         visible) - the toggle itself, same as its curve below (steerLimitConfigSection).
         Its on/off state and curve still persist/re-apply via ModePrefs regardless
         (ControllerDriveActivity), so Safe steering keeps working across a restart
         even while this toggle isn't shown. -->
    <Button
        android:id="@+id/buttonSteerLimit"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:text="@string/controller_steer_limit" />

    <!-- Tunes the curve Safe steering (above) uses - debug-only, day-to-day driving
         just wants it on/off, not to retune the curve. -->
    <LinearLayout
        android:id="@+id/steerLimitConfigSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textSteerLimitMaxSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:text="@string/controller_steer_limit_max_speed" />

        <SeekBar
            android:id="@+id/seekSteerLimitMaxSpeed"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            android:id="@+id/textSteerLimitReduction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:text="@string/controller_steer_limit_reduction" />

        <SeekBar
            android:id="@+id/seekSteerLimitReduction"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:max="100" />
    </LinearLayout>

    <!-- Video quality: manual Low/Med/High picks, or Auto to let the app step down/up
         from decoded FPS - see ControllerDriveActivity's auto-quality loop. Manual
         buttons turn Auto off. Debug-only: starts at HIGH and rarely needs touching
         day to day, this is for deliberately trading quality for bandwidth. -->
    <LinearLayout
        android:id="@+id/qualitySection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/buttonQualityLow"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controller_quality_low" />

        <Button
            android:id="@+id/buttonQualityMedium"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controller_quality_medium" />

        <Button
            android:id="@+id/buttonQualityHigh"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controller_quality_high" />

        <CheckBox
            android:id="@+id/checkAutoQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:text="@string/controller_quality_auto" />

        <!-- Tells the vehicle to start/stop GPS (ControlFrame.TelemetryEnable) and
             send its speed/position back - off by default so the vehicle isn't
             burning battery on location fixes nobody's looking at. Shown in the
             debug overlay (textDebugOverlay) once data arrives. -->
        <CheckBox
            android:id="@+id/checkTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:text="@string/controller_telemetry" />
    </LinearLayout>

    <!-- Debug-only (log + FPS/latency): bottom instead of top - a top overlay kept
         rendering under the status bar's clock/battery icons on some phones even with
         this screen going immersive (WindowInsetsControllerCompat, onCreate), so bottom
         sidesteps that entirely rather than chasing the immersive-mode gap further. -->
    <TextView
        android:id="@+id/textRtcLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:maxLines="4" />

    <TextView
        android:id="@+id/textDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:text="FPS: -- | Latency: -- ms" />

    <!-- Icon-only: plain red dot (record_button_idle) while idle, red square
         (record_button_active, standard "tap to stop") while recording - see
         setUpRecordButton()'s doc for the toggle logic. -->
    <ImageButton
        android:id="@+id/buttonRecord"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/record_button_idle"
        android:contentDescription="@string/controller_record"
        android:padding="16dp"
        android:scaleType="fitCenter" />

</FrameLayout>
