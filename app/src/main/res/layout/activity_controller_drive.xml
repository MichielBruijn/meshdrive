<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- TextureView (not SurfaceView) because correct display needs a rotation
         transform (Matrix) - SurfaceView doesn't support that, TextureView does.
         Sized/rotated in code once the vehicle's orientation is known, kept at its
         native aspect ratio (no stretching) - see ControllerDriveActivity. -->
    <TextureView
        android:id="@+id/textureVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Steering, left side, vertically centered: horizontal slider, left/right only.
         Nudged in further than a plain edge margin - on some phones (front-camera
         cutout in landscape) the very left edge sits under/behind the controller's
         own camera, per direct feedback. -->
    <nu.bruijn.rcvehicle.controller.SliderView
        android:id="@+id/sliderSteer"
        android:layout_width="240dp"
        android:layout_height="100dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="70dp" />

    <!-- Throttle, vertically centered, nudged in from the right edge for easier
         thumb reach: vertical slider, forward/backward only. -->
    <nu.bruijn.rcvehicle.controller.SliderView
        android:id="@+id/sliderThrottle"
        android:layout_width="100dp"
        android:layout_height="240dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="50dp" />

    <!-- Always visible (not debug) - a real driving-safety signal, not a diagnostic
         detail. Hidden (empty text) while the link looks healthy. -->
    <TextView
        android:id="@+id/textConnectionWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:textColor="#FFEB3B"
        android:textStyle="bold"
        android:background="#AA000000"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <CheckBox
            android:id="@+id/checkSteerLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:text="@string/controller_steer_limit" />

        <!-- Switches which of the vehicle phone's two cameras streams - see
             VideoSender.switchCamera(). Not a picture-in-picture mirror (that needs
             concurrent dual-camera capture, not supported on every phone) - this
             swaps the single stream, so the main view itself becomes the rear view
             while checked. -->
        <CheckBox
            android:id="@+id/checkRearView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:text="@string/controller_rear_view" />

        <!-- Video quality: manual Low/Med/High picks, or Auto to let the app step
             down/up from decoded FPS - see ControllerDriveActivity's auto-quality
             loop. Manual buttons turn Auto off. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/buttonQualityLow"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controller_quality_low" />

            <Button
                android:id="@+id/buttonQualityMedium"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controller_quality_medium" />

            <Button
                android:id="@+id/buttonQualityHigh"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controller_quality_high" />

            <CheckBox
                android:id="@+id/checkAutoQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:text="@string/controller_quality_auto" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textRtcLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:maxLines="4" />

    <!-- Debug overlay: decoded frame rate and control round-trip latency. -->
    <TextView
        android:id="@+id/textDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:text="FPS: -- | Latency: -- ms" />

</FrameLayout>
