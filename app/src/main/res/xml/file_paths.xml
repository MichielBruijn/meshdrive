<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes only cache/updates/ (where AppUpdater saves a downloaded APK) via
     FileProvider - nothing else in the app's storage needs to be reachable
     through this. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="updates/" />
</paths>
